# ============================================================================
#  Trading Platform — environment template. Copy to `.env` and fill in.
#  NEVER commit a real .env (gitleaks blocks it). Values here are safe defaults.
# ============================================================================

# --- App ---
APP_ENV=local                       # local | staging | production
APP_NAME=trading-platform
LOG_LEVEL=INFO
LOG_JSON=false                      # true in prod; pretty console locally

# --- Security ---
# Signs research-graph APPROVAL TOKENS (app/modules/ai/graph/approval.py) — an HMAC
# over the strategy hash, dataset fingerprint, plan hash and risk-policy version.
# Rotating it invalidates every outstanding approval, which is correct behaviour but
# is a real effect, not a no-op. (CSRF tokens are random per-session values and are
# NOT signed with this.)
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-only-change-me-please
COOKIE_SECURE=false                 # true in prod (HTTPS only)
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=1209600         # 14 days
# 32-byte key (base64) for encrypting broker credentials at rest (libsodium secretbox).
# GENERATE YOUR OWN — a key copied from a doc, a chat or another deployment protects
# nothing, because everyone who has it can decrypt everyone else's credentials.
# Generate: python -c "import base64,nacl.utils;print(base64.b64encode(nacl.utils.random(32)).decode())"
BROKER_CRED_KEY=
# Shared secret for the POST /internal/tick cron endpoint (only needed on free PaaS
# hosts without a background worker; empty = endpoint disabled).
# Send it as `Authorization: Bearer <TICK_SECRET>`; the ?key= query form still works
# but puts the secret in every proxy/host access log, so prefer the header.
TICK_SECRET=

# --- CORS (credentialed allowlist — NO wildcard) ---
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend URL: password-reset links are built from this. In production it MUST be
# the real web origin — left at localhost, every reset email is a dead link, and the
# app logs a loud `insecure_production_config` warning at startup. ---
FRONTEND_URL=http://localhost:3000

# --- Email for password reset. Unset => NOTHING IS SENT: the link is written to the
# application log instead, so reset does not work for your users and live tokens end
# up in your log store. Configure this on any deployment real people use.
# To actually SEND email, use a free Gmail App Password (works for anyone with a Gmail):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Google Account -> Security -> App passwords -> generate one (16 chars).
#   3. Set SMTP_USER to that Gmail address + SMTP_PASSWORD to the app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Database (PostgreSQL + TimescaleDB) ---
# Container maps to host 55432 (avoids clashing with a native PostgreSQL on 5432).
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:55432/trading

# --- Redis (cache / pub-sub / sessions / rate-limit / ARQ) ---
REDIS_URL=redis://localhost:56379/0

# --- Rate limiting / request size ---
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=2000000           # reject larger request bodies with 413 (DoS guard)
# X-Forwarded-For is client-supplied, so it is only believed when you say a proxy of
# yours produced it. Leave FALSE for local/direct exposure: turning it on there lets
# anyone mint a fresh rate-limit bucket per request by inventing a header value.
TRUST_PROXY_HEADERS=false           # true behind Caddy / Render / HF Spaces / Cloudflare
# Number of proxies between the internet and the API. The client IP is read as the
# Nth-from-the-RIGHT XFF entry, because each trusted hop appends the peer it heard
# from; everything to the left of that is whatever the caller wrote.
#   1 = one reverse proxy (Caddy, Render, HF Spaces)   2 = Cloudflare -> Caddy
TRUSTED_PROXY_HOPS=1

# --- Observability ---
SENTRY_DSN=
# Bearer token required to scrape /metrics (Prometheus sends Authorization: Bearer <token>).
# Empty = /metrics returns 404 (fail-closed), i.e. nothing can scrape it. Put the SAME
# value in infra/secrets/metrics_token — see the wiring notes in infra/prometheus.yml.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# --- Market data ---
MARKET_DATA_TIMEOUT_SECONDS=30      # bound external provider calls (CCXT/yfinance/Alpaca)

# --- AI (Phase 6): both options are FREE ---
#   gemini  -> free API key from https://aistudio.google.com/apikey  (set GEMINI_API_KEY)
#   ollama  -> fully local, no key; install Ollama + `ollama pull llama3.1` and set provider=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=gemini          # gemini | ollama

# --- Market data: crypto (CCXT) + equities (yfinance) need NO key and work out of the box.
# --- Alpaca is optional (free paper keys at https://alpaca.markets) for equities/live seam.
ALPACA_API_KEY=
ALPACA_API_SECRET=
