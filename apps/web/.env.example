# ---------------------------------------------------------------------------
# Server-side only (read by the Next server at runtime).
# ---------------------------------------------------------------------------
# Where Next proxies /api/* (the FastAPI backend). Also used by server components
# to reach the PUBLIC endpoints, which have no relative origin to resolve against.
API_PROXY_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Client-side (NEXT_PUBLIC_*). These are INLINED into the browser bundle at
# `next build` time — a value set only as container runtime env arrives too late
# and is ignored. In Docker they must be passed as build args (see
# infra/Dockerfile.web).
# ---------------------------------------------------------------------------
# Client-side base — same-origin proxy so cookies stay first-party.
NEXT_PUBLIC_API_BASE=/api

# Browser connects to the backend WebSocket directly (ticket-authed, no cookie).
# Leave this EMPTY in any deployment where the WS is reachable on the page's own
# origin (the Caddy prod topology proxies /api/market/ws): the client then derives
# ws(s)://<current-origin>/api/market/ws, which can never point at the wrong host.
# In local dev the Next rewrite does not forward the WS upgrade, so point it at the
# API directly.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/market/ws

# Canonical public origin, no trailing slash (e.g. https://example.com). Consumed by
# metadataBase, canonical/OG URLs, JSON-LD, robots.txt and the sitemap.
# UNSET is treated as "origin unknown": the app emits noindex, drops the sitemap and
# omits absolute URLs rather than asserting a domain it is not served from. Set it in
# every real deployment.
NEXT_PUBLIC_SITE_URL=

# Sentry error tracking. Leave blank to disable (all Sentry init is DSN-gated, so
# an empty value makes the instrumentation a no-op). Set the public DSN to enable.
NEXT_PUBLIC_SENTRY_DSN=
