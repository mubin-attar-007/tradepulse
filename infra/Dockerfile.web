# Frontend image (Next.js standalone). Build context = apps/web.
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_* are INLINED into the client bundle by `next build`; setting them as
# container runtime env (compose `environment:`) is too late and silently ships the
# in-code fallbacks instead. They have to be present HERE, before the build — pass
# real values through `build.args` in compose/CI.
#
# The defaults below are the correct same-origin production values for the Caddy
# topology (everything under one host, /api/* stripped to the API), so an image built
# with no args is still honest rather than pointing at a developer's localhost.
ARG NEXT_PUBLIC_API_BASE=/api
# Empty on purpose: the client then derives ws(s)://<this-origin>/api/market/ws at
# runtime, which is right for any host the app is actually served from. Set it only
# when the WebSocket lives on a different origin than the page.
ARG NEXT_PUBLIC_WS_URL=
# Canonical public origin (e.g. https://example.com). UNSET means "unknown": the app
# degrades to noindex and omits absolute canonical/OG/JSON-LD/sitemap URLs rather than
# asserting a domain it is not served from.
ARG NEXT_PUBLIC_SITE_URL=
# Public Sentry DSN. Empty leaves the browser instrumentation a no-op (it is DSN-gated).
ARG NEXT_PUBLIC_SENTRY_DSN=
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN} \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim AS runtime
WORKDIR /app
RUN useradd -m -u 10001 appuser
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
USER appuser
EXPOSE 3000
CMD ["node", "server.js"]
